{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Speculators Eval Results",
  "type": "object",
  "required": ["updated_at", "baselines", "models"],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "baselines": {
      "type": "object",
      "description": "Autoregressive throughput baselines keyed by target model ID",
      "additionalProperties": { "$ref": "#/$defs/baseline" }
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "baseline": {
      "type": "object",
      "description": "Throughput per GPU config for a target model without a drafter",
      "additionalProperties": {
        "type": "number",
        "description": "Throughput in tokens/sec for this GPU config"
      },
      "minProperties": 1
    },
    "model": {
      "type": "object",
      "required": [
        "model",
        "target",
        "algorithm",
        "num_speculative_tokens",
        "hf_last_modified",
        "evaluated_at",
        "gpus",
        "status",
        "metrics",
        "error",
        "deploy"
      ],
      "properties": {
        "model": { "type": "string" },
        "target": { "type": ["string", "null"] },
        "algorithm": { "type": ["string", "null"] },
        "num_speculative_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "hf_last_modified": { "type": ["string", "null"], "format": "date-time" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "gpus": { "type": "string" },
        "params": {
          "type": "integer",
          "minimum": 1,
          "description": "Drafter parameter count from HF safetensors metadata; optional for records captured before metadata enrichment"
        },
        "architecture": {
          "type": "string",
          "description": "Drafter architecture from HF config (e.g. Eagle3Speculator); optional for records captured before metadata enrichment"
        },
        "base_model": {
          "type": "string",
          "description": "Base model the drafter was trained from, per HF card data; optional, not always published"
        },
        "status": { "type": "string", "enum": ["ok", "failed"] },
        "metrics": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/metrics" }
          ]
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "type": "string" }
          ]
        },
        "deploy": { "$ref": "#/$defs/deploy" },
        "provenance": {
          "type": "object",
          "description": "Resolved source, dependency, checkpoint, and benchmark versions for a WDC eval"
        }
      },
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "required": ["command", "recipe_source", "recipe_model"],
      "properties": {
        "command": { "type": "string" },
        "recipe_source": { "type": "string" },
        "recipe_model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "acceptance_length",
        "acceptance_at_pos",
        "num_drafts",
        "throughput_tps",
        "speedup",
        "ttft_ms",
        "itl_ms",
        "subsets"
      ],
      "properties": {
        "acceptance_length": { "type": "number" },
        "acceptance_at_pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "num_drafts": { "type": "integer", "minimum": 0 },
        "throughput_tps": { "type": "number" },
        "speedup": { "type": "number" },
        "ttft_ms": { "type": "number" },
        "itl_ms": { "type": "number" },
        "subsets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/subset" },
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "subset": {
      "type": "object",
      "required": [
        "acceptance_length",
        "acceptance_at_pos",
        "num_drafts",
        "num_draft_tokens",
        "num_accepted_tokens",
        "throughput_tps",
        "speedup",
        "ttft_ms",
        "itl_ms"
      ],
      "properties": {
        "acceptance_length": { "type": "number" },
        "acceptance_at_pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "num_drafts": { "type": "integer", "minimum": 0 },
        "num_draft_tokens": { "type": "integer", "minimum": 0 },
        "num_accepted_tokens": { "type": "integer", "minimum": 0 },
        "throughput_tps": { "type": "number" },
        "speedup": { "type": "number" },
        "ttft_ms": { "type": "number" },
        "itl_ms": { "type": "number" },
        "sweep": {
          "type": "array",
          "description": "All sweep rate points (latency-vs-throughput curve); optional for backwards compatibility with results captured before sweep preservation",
          "items": { "$ref": "#/$defs/sweep_point" }
        }
      },
      "additionalProperties": false
    },
    "sweep_point": {
      "type": "object",
      "description": "One rate point from a perf sweep; numeric fields are null when missing or non-finite (e.g. infinite target rate)",
      "required": [
        "target_rate",
        "rps_median",
        "latency_median_s",
        "ttft_median_ms",
        "itl_median_ms",
        "output_tps_median"
      ],
      "properties": {
        "target_rate": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "rps_median": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "latency_median_s": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "ttft_median_ms": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "itl_median_ms": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "output_tps_median": { "oneOf": [{ "type": "number" }, { "type": "null" }] }
      },
      "additionalProperties": false
    }
  }
}
